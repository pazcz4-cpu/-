{
  "name": "maiphone-shift-scheduler",
  "version": "1.0.0",
  "description": "מערכת סידור משמרות שבועי לעובדים בסניפי מייפון – שיבוץ אוטומטי, אילוצים וזיהוי כפל משמרות",
  "private": true,
  "scripts": {
