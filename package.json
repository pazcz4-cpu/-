    "test:tenancy": "node tests/tenancy-tests.js",
    "test:all": "node tests/run-tests.js && node tests/tenancy-tests.js && node tests/i18n-tests.js && node tests/supabase-tests.js && node tests/billing-webhook-tests.js && node tests/billing-cron-tests.js",
    "test:saas": "node tests/saas-browser-test.mjs && node tests/roles-browser-test.mjs",
    "test:billing": "node tests/billing-browser-test.mjs",
    "test:approval": "node tests/approval-browser-test.mjs",
    "test:reason": "node tests/reason-notify-test.mjs",
    "test:shifts": "node tests/shifts-browser-test.mjs",
    "test:deadline": "node tests/deadline-browser-test.mjs",
    "test:preview": "node tests/preview-browser-test.mjs",
    "test:why": "node tests/why-browser-test.mjs",
    "test:save": "node tests/save-state-browser-test.mjs",
    "test:publish": "node tests/publish-browser-test.mjs",
    "test:password": "node tests/password-browser-test.mjs",
    "test:import": "node tests/import-browser-test.mjs",
    "test:employees": "node tests/employees-browser-test.mjs",
    "test:invite": "node tests/invite-browser-test.mjs",
    "test:limit": "node tests/constraint-limit-browser-test.mjs",
    "test:account": "node tests/account-browser-test.mjs",
    "test:view": "node tests/view-browser-test.mjs",
    "brand": "node tools/logo.js",
    "test:support": "node tests/support-browser-test.mjs",
    "test:confirm": "node tests/confirm-email-browser-test.mjs",
    "test:lang": "node tests/language-browser-test.mjs",
    "test:i18n": "node tests/i18n-tests.js",
    "build:site": "node build-site.js",
    "build:preview": "node build-landing-artifact.js",
    "serve": "node build-site.js && node tools/serve.js",
    "test:site": "node build-site.js && node tests/site-browser-test.mjs",
    "test:supabase": "node tests/supabase-tests.js",
    "test:webhook": "node tests/billing-webhook-tests.js",
    "test:trial": "node tests/trial-browser-test.mjs",
    "test:cron": "node tests/billing-cron-tests.js"
